# Grok Bot Notify config. Copy to "$(herdr plugin config-dir grokbot-notify)/.env"
# (or run setup.sh, which writes it for you with chmod 600).
# Never commit the real file.

# Required: copy both from your Grok Bot routine's webhook trigger panel.
GROKBOT_WEBHOOK_URL=
# Either the full header line ("Authorization: Bearer ...") or just the value ("Bearer ...").
GROKBOT_WEBHOOK_AUTH=

# Optional tuning (defaults shown).
# Comma-separated agent statuses that trigger a webhook.
GROKBOT_NOTIFY_STATUSES=done,blocked
# Comma-separated substrings matched against the pane's detected agent name; "*" = any agent.
GROKBOT_NOTIFY_AGENTS=claude,codex
# Skip repeats of the same pane + status within this many seconds.
GROKBOT_NOTIFY_DEBOUNCE_SECS=180
# Seconds before the HTTP request gives up.
GROKBOT_NOTIFY_TIMEOUT_SECS=10
# Include this machine's short hostname in the payload (1/0).
GROKBOT_NOTIFY_INCLUDE_HOST=1
