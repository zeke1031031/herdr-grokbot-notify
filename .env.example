# Grok Bot Notify config. Copy to "$(herdr plugin config-dir grokbot-notify)/.env"
# (or run the setup popup, setup.sh or configure.sh, which write it for you with chmod 600).
# Never commit the real file.

# Required: copy both from your Grok Bot routine's webhook trigger panel.
GROKBOT_WEBHOOK_URL=
# Either the full header line ("Authorization: Bearer ...") or just the value ("Bearer ...").
GROKBOT_WEBHOOK_AUTH=

# Optional (defaults shown). Leave these out to get: every agent; finished,
# blocked, and agent/pane exits.

# Comma-separated agent ids or substrings (claude,codex,cursor,gemini,opencode,...); "*" = every agent.
GROKBOT_NOTIFY_AGENTS=*
# herdr events that may fire the webhook. Change this with
#   bash configure.sh --events +tab.created,-pane.exited     (see: configure.sh --list)
# which also registers optional events with herdr. If you edit it here by hand,
# run `bash configure.sh --apply` afterwards. agent.released = pane.agent_detected
# with released:true (agent quit/crashed).
GROKBOT_NOTIFY_EVENTS=pane.agent_status_changed,agent.released,pane.exited
# Statuses for pane.agent_status_changed. done/idle = finished turn, blocked = needs input.
# Add working or unknown to be told about every change to those states.
# done,blocked = only while you're not looking at the pane ("only when I'm away").
GROKBOT_NOTIFY_STATUSES=done,idle,blocked
# Skip identical back-to-back repeats of the same pane + reason within this many
# seconds (0 = off). Any status change in between lets the next one through.
GROKBOT_NOTIFY_DEBOUNCE_SECS=60
# Seconds before the HTTP request gives up.
GROKBOT_NOTIFY_TIMEOUT_SECS=10
# Include this machine's short hostname in the payload (1/0).
GROKBOT_NOTIFY_INCLUDE_HOST=1
# Send the last N lines of the agent's pane as "output" (0 = off, max 500).
# WARNING: terminal output can contain secrets (tokens, .env contents) and is sent
# to your Grok Bot routine.
GROKBOT_NOTIFY_OUTPUT_LINES=0
# Byte cap for "output"; the newest lines are kept.
GROKBOT_NOTIFY_OUTPUT_MAX_BYTES=4000
